<div class="container py-5">
  <div class="game-card mx-auto">
    <h1 class="h3 mb-1">New game</h1>
    <p class="text-muted mb-4">
      Make the longest English word you can from these letters.
      Each letter can only be used as many times as it appears.
    </p>

    <ul class="letters list-unstyled d-flex gap-1 mb-4">
      <% @letters.each do |letter| %>
        <li class="letter"><%= letter %></li>
      <% end %>
    </ul>

    <form action="/score" method="post" data-turbo="false">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <%= hidden_field_tag :letters, @letters.join(" ") %>

      <label for="word" class="form-label">Your word</label>
      <input type="text" id="word" name="word" class="form-control mb-3" autocomplete="off" autofocus>
      <input type="submit" value="Play" class="btn btn-dark w-100">
    </form>
  </div>
</div>
