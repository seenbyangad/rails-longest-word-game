<h1>Your result</h1>

<% if @result == :not_in_grid %>
  <p>❌ Sorry, but <strong><%= @word %></strong> can't be built out of <%= @letters.join(", ") %>.</p>
<% elsif @result == :not_english %>
  <p>❌ Sorry, but <strong><%= @word %></strong> does not seem to be a valid English word.</p>
<% else %>
  <p>✅ Congratulations! <strong><%= @word %></strong> is a valid English word!</p>
<% end %>

<%= link_to "New game", new_path %>
